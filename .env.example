# ------------------------------------------------------------------
# ISKCON Disciples Course (IDC) Management Portal - environment
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret to source control.
# ------------------------------------------------------------------

# Public site URL (used for auth redirects, links, receipt/verification URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ------------------------------------------------------------------
# Safe to expose to the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SERVER ONLY. Never expose this to the client. Used by the admin
# service-role client for privileged operations (registration,
# certificate issue, etc.). Bypasses RLS - keep it secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ------------------------------------------------------------------
# Optional: initial Super Admin bootstrap (used only by scripts/create-admin)
# ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_ADMIN_NAME=IDC Administrator

# ------------------------------------------------------------------
# Optional future integration: online payment gateway (Razorpay etc.)
# Leave blank to run in manual-payment mode (default).
# ------------------------------------------------------------------
# PAYMENT_GATEWAY_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# Optional future integration: WhatsApp Business Platform (Cloud API)
# Leave blank to use the review-then-send WhatsApp link flow (default).
# ------------------------------------------------------------------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
